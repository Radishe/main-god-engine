    "si": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["X01-01", "X02-01", "X03-01", "X04-01", "X05-01"], "note": "cross-stage handoff + package integration suite; no single stage owns these"},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": ["config/tiers.json"], "tests": ["I9-01"], "note": "D21 tier scale closure; global config invariant"}
