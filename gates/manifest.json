{
  "version": 1,
  "note": "门禁清单，由 gates/check.py 消费。本文件是判定依据；00 文件的表格降级为人类可读索引。",
  "exit_rule": "pending_count == 0 and missing_active_files == 0 and runner_exit == 0",
  "layers": {
    "invariant": "不依赖玩法数值，S0 完成即可写成测试",
    "config_driven": "测试骨架先写，断言引用 config/*；配置定稿后自动激活",
    "human_in_loop": "机器留痕 + 人工签字，不假装自动化"
  },
  "status_values": ["active", "pending"],
  "stages": {
    "s0": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G1-01", "S0-G1-02", "S0-G1-03"]},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G2-01", "S0-G2-02", "S0-G2-03", "S0-G2-04"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G3-01"]}
    ],
    "s1": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S1-G1-01", "S1-G1-02", "S1-G1-03"]},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S1-G2-01", "S1-G2-02", "S1-G2-03", "S1-G2-04"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S1-G3-01", "S1-G3-02", "S1-G3-03"]},
      {"gate": "G4", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S1-G4-01"]}
    ],
    "s2": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S2-G1-01", "S2-G1-02", "S2-G1-03"]},
      {"gate": "G2", "layer": "human_in_loop", "status": "active", "depends_on": [], "tests": ["S2-G2-01", "S2-G2-02", "S2-G2-03"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S2-G3-01", "S2-G3-02", "S2-G3-03"]}
    ],
    "s3": [
      {"gate": "G1", "layer": "config_driven", "status": "pending", "depends_on": ["config/tiers.json"], "tests": ["S3-G1-01", "S3-G1-02", "S3-G1-03"]},
      {"gate": "G2", "layer": "config_driven", "status": "pending", "depends_on": ["config/scoring.json"], "tests": ["S3-G2-01", "S3-G2-02", "S3-G2-03"]},
      {"gate": "G3", "layer": "config_driven", "status": "pending", "depends_on": ["config/scoring.json"], "tests": ["S3-G3-01", "S3-G3-02", "S3-G3-03"]},
      {"gate": "G4", "layer": "config_driven", "status": "pending", "depends_on": ["config/penalty.json", "config/states.json"], "tests": ["S3-G4-01", "S3-G4-02", "S3-G4-03"]},
      {"gate": "G5", "layer": "config_driven", "status": "pending", "depends_on": ["config/volume.json"], "tests": ["S3-G5-01", "S3-G5-02"]},
      {"gate": "G6", "layer": "config_driven", "status": "pending", "depends_on": ["config/timeline.json"], "tests": ["S3-G6-01", "S3-G6-02", "S3-G6-03"]}
    ],
    "s4": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S4-G1-01", "S4-G1-02", "S4-G1-03"]},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S4-G2-01", "S4-G2-02"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S4-G3-01", "S4-G3-02"]},
      {"gate": "G4", "layer": "human_in_loop", "status": "active", "depends_on": ["config/maintainers.json"], "tests": ["S4-G4-01", "S4-G4-02", "S4-G4-03"]}
    ],
    "sc": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["C09-01", "C10-01", "C13-01", "C14-01", "C30-01"], "note": "shared contract suite: waiting for P1/P3/P4 implementation, G1 golden path included"},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["C01-01", "C11-01", "C12-01", "C25-01"], "note": "D14/D15/D16 已拍板，结构化结论落在共享 config/"},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["C15-01", "C16-01"], "note": "D13.22 骨架已落地：config/scenes.json 与 settlement_units.json 的已定部分 ratified、未拍部分显式 UNRATIFIED 且拒绝偷渡，断言验的是结构契约不变量，故从 config_driven 改 invariant 并激活"}
    ],
    "si": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["X01-01", "X02-01", "X03-01", "X04-01", "X05-01"], "note": "cross-stage handoff + package integration suite; no single stage owns these"},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": ["config/tiers.json"], "tests": ["I9-01"], "note": "D21 tier scale closure; global config invariant"}
    ]
  }
}
