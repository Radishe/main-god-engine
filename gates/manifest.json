      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S4-G2-01", "S4-G2-02"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S4-G3-01", "S4-G3-02"]},
