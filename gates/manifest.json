  },
  "status_values": ["active", "pending"],
  "stages": {
    "s0": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G1-01", "S0-G1-02", "S0-G1-03"]},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G2-01", "S0-G2-02", "S0-G2-03", "S0-G2-04"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S0-G3-01"]}
