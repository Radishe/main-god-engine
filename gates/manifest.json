      {"gate": "G2", "layer": "human_in_loop", "status": "active", "depends_on": [], "tests": ["S2-G2-01", "S2-G2-02", "S2-G2-03"]},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S2-G3-01", "S2-G3-02", "S2-G3-03"]}
    ],
    "s3": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S3-G1-01", "S3-G1-02", "S3-G1-03"], "note": "D23 后续：配置定稿+测试补齐，从 config_driven+pending 激活"},
      {"gate": "G2", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S3-G2-01", "S3-G2-02", "S3-G2-03"], "note": "D20 评分数值已定稿（scoring.json ACTIVE），三条测试转真断言"},
      {"gate": "G3", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S3-G3-01", "S3-G3-02", "S3-G3-03"], "note": "权重作用点 factor_applies_to=score 已由 D20 定稿"},
      {"gate": "G4", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S3-G4-01", "S3-G4-02", "S3-G4-03"], "note": "G4-01 按 D14 废弃单位机制保留真红；G4-02 验废弃状态；G4-03 验非抹杀态"},
      {"gate": "G5", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["S3-G5-01", "S3-G5-02"], "note": "体量上限 T4 保持 UNRATIFIED；G5-02 记录 D2 未产出"},
