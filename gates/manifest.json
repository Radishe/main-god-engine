    "sc": [
      {"gate": "G1", "layer": "invariant", "status": "active", "depends_on": [], "tests": ["C09-01", "C10-01", "C13-01", "C14-01", "C30-01"], "note": "shared contract suite: waiting for P1/P3/P4 implementation, G1 golden path included"},
